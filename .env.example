# Conexión como dueño del esquema (migraciones, seed). Nunca la usa la app en runtime.
DATABASE_URL_ADMIN=postgres://winzer:winzer@localhost:5442/winzer
# Conexión de la app: rol sin BYPASSRLS, sujeto a Row-Level Security.
DATABASE_URL=postgres://winzer_app:winzer_app@localhost:5442/winzer
BETTER_AUTH_SECRET=cambia-esto-por-un-valor-aleatorio-de-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# Adjuntos (ADR 0013): almacenamiento compatible con S3. Local: s3mock de docker-compose. Producción: Cloudflare R2
# (endpoint https://<cuenta>.r2.cloudflarestorage.com, región auto, CORS del bucket con PUT/GET desde el dominio).
S3_ENDPOINT=http://localhost:9442
S3_REGION=auto
S3_BUCKET=winzer
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
# Solo desarrollo/CI: crea el bucket si no existe.
S3_CREAR_BUCKET=1

# Correo (F0-8): sin RESEND_API_KEY los correos se escriben en la consola del servidor (desarrollo/CI).
# RESEND_API_KEY=re_...
# CORREO_REMITENTE=Winzer <no-responder@tu-dominio.cl>   (el dominio debe estar verificado en Resend)
